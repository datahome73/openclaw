{
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "startCommand": "node -e \"require('fs').writeFileSync('/home/node/.openclaw/openclaw.json', JSON.stringify({agents:{defaults:{model:{primary:'deepseek/deepseek-v4-flash',fallbacks:['deepseek/deepseek-chat']}}}}))\" && node openclaw.mjs gateway --bind lan",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
