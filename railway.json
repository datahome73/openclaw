{
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "startCommand": "mkdir -p /home/node/.openclaw/state /home/node/.openclaw/workspace && node openclaw.mjs gateway --bind lan --allow-unconfigured",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
